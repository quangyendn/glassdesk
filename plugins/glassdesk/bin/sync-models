#!/usr/bin/env node
// bin/sync-models — Resolve agent `tier:` → `model:` + `effort:` from
// config/models.yml.
//
// Purpose: keep all agents' `model:` and `effort:` frontmatter in sync with
// the central tier policy in plugins/glassdesk/config/models.yml. Run after
// editing the policy file or when adding/changing an agent's `tier:`.
// Tiers without an `effort:` key (e.g. haiku-backed `fast`) must have NO
// effort field in agent frontmatter — sync removes it if present.
//
// Modes:
//   (default)   write changes; print synced lines
//   --check     dry-run; exit 1 on drift (CI / pre-commit)
//   --verbose   log every agent inspected (including no-ops)
//
// Zero dependency: regex-based YAML + frontmatter parser. Schema is fixed
// and small (a handful of tiers, simple key:value). If you extend models.yml
// beyond the documented schema, swap to `js-yaml`.

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PLUGIN_ROOT = path.resolve(__dirname, '..');
const CONFIG_PATH = path.join(PLUGIN_ROOT, 'config', 'models.yml');
const AGENTS_DIR = path.join(PLUGIN_ROOT, 'agents');

const args = new Set(process.argv.slice(2));
const CHECK = args.has('--check');
const VERBOSE = args.has('--verbose');

// ---------------------------------------------------------------------------
// Minimal YAML parser — handles only our 2-level schema:
//   tiers:
//     <tier-name>:
//       <key>: <value>
// Comments (`# ...`) are stripped. Blank lines ignored.
// ---------------------------------------------------------------------------
function parseConfig(yamlText) {
  const lines = yamlText.split('\n');
  const tiers = {};
  let currentTier = null;
  for (const raw of lines) {
    const line = raw.replace(/#.*$/, '').trimEnd();
    if (!line.trim()) continue;
    if (/^tiers:\s*$/.test(line)) continue;
    const tierMatch = line.match(/^  ([a-z_]+):\s*$/);
    if (tierMatch) {
      currentTier = tierMatch[1];
      tiers[currentTier] = {};
      continue;
    }
    const kvMatch = line.match(/^    ([a-z_]+):\s*(.+?)\s*$/);
    if (kvMatch && currentTier) {
      tiers[currentTier][kvMatch[1]] = kvMatch[2];
    }
  }
  return { tiers };
}

// ---------------------------------------------------------------------------
// Frontmatter helpers — extract top-level key:value pairs and rewrite scalar
// fields in place. Only top-level scalar fields are inspected; nested
// structures (arrays, multiline strings) in description/etc are preserved
// untouched.
// ---------------------------------------------------------------------------
function readFrontmatter(text) {
  const m = text.match(/^---\n([\s\S]*?)\n---\n/);
  if (!m) return null;
  const fmText = m[1];
  const fields = {};
  for (const line of fmText.split('\n')) {
    const kv = line.match(/^([a-z_]+):\s*(.*)$/);
    if (kv) fields[kv[1]] = kv[2];
  }
  return { fmText, fields };
}

// Set `key: value` in frontmatter — rewrite in place if present, otherwise
// insert after `afterKey:` line if present, else append at end of frontmatter.
function setField(text, key, value, afterKey) {
  const fmMatch = text.match(/^---\n([\s\S]*?)\n---\n/);
  if (!fmMatch) return text;
  const fmBody = fmMatch[1];

  let newFm;
  if (new RegExp(`^${key}:\\s*.+$`, 'm').test(fmBody)) {
    newFm = fmBody.replace(new RegExp(`^(${key}:\\s*)\\S.*$`, 'm'), `$1${value}`);
  } else if (afterKey && new RegExp(`^${afterKey}:\\s*\\S+\\s*$`, 'm').test(fmBody)) {
    newFm = fmBody.replace(
      new RegExp(`^(${afterKey}:\\s*\\S+)\\s*$`, 'm'),
      `$1\n${key}: ${value}`
    );
  } else {
    newFm = `${fmBody}\n${key}: ${value}`;
  }
  return text.replace(fmMatch[0], `---\n${newFm}\n---\n`);
}

// Remove `key:` line from frontmatter (used when a tier defines no effort —
// e.g. haiku-backed tiers — so a hand-added field is self-healed away).
function removeField(text, key) {
  const fmMatch = text.match(/^---\n([\s\S]*?)\n---\n/);
  if (!fmMatch) return text;
  const newFm = fmMatch[1]
    .split('\n')
    .filter((line) => !new RegExp(`^${key}:`).test(line))
    .join('\n');
  return text.replace(fmMatch[0], `---\n${newFm}\n---\n`);
}

const VALID_EFFORTS = ['low', 'medium', 'high', 'xhigh', 'max'];

// ---------------------------------------------------------------------------
// Main loop — iterate agent files, resolve tier→model+effort, write or
// check drift.
// ---------------------------------------------------------------------------
function main() {
  if (!fs.existsSync(CONFIG_PATH)) {
    console.error(`ERROR: ${CONFIG_PATH} not found`);
    process.exit(1);
  }
  const config = parseConfig(fs.readFileSync(CONFIG_PATH, 'utf8'));
  for (const [name, def] of Object.entries(config.tiers)) {
    if (def.effort !== undefined && !VALID_EFFORTS.includes(def.effort)) {
      console.error(
        `ERROR: tier "${name}" has invalid effort "${def.effort}". Valid: ${VALID_EFFORTS.join(', ')} (or omit)`
      );
      process.exit(1);
    }
  }
  const agentFiles = fs
    .readdirSync(AGENTS_DIR)
    .filter((f) => f.endsWith('.md'))
    .sort();

  let drift = 0;
  let synced = 0;
  let warned = 0;
  let inspected = 0;

  for (const file of agentFiles) {
    const fpath = path.join(AGENTS_DIR, file);
    const text = fs.readFileSync(fpath, 'utf8');
    const fm = readFrontmatter(text);
    if (!fm) {
      console.warn(`WARN: ${file} has no frontmatter, skipped`);
      warned++;
      continue;
    }
    const tier = fm.fields.tier;
    if (!tier) {
      if (VERBOSE) console.warn(`WARN: ${file} has no tier:, skipped (manual override)`);
      warned++;
      continue;
    }
    const tierDef = config.tiers[tier];
    if (!tierDef) {
      console.error(
        `ERROR: ${file} has unknown tier "${tier}". Valid: ${Object.keys(config.tiers).join(', ')}`
      );
      process.exit(1);
    }
    inspected++;
    const expectedModel = tierDef.model;
    const expectedEffort = tierDef.effort; // undefined ⇒ field must be absent
    const currentModel = fm.fields.model;
    const currentEffort = fm.fields.effort;

    const driftedFields = [];
    if (currentModel !== expectedModel) {
      driftedFields.push({ key: 'model', expected: expectedModel, actual: currentModel });
    }
    if (currentEffort !== expectedEffort) {
      driftedFields.push({ key: 'effort', expected: expectedEffort, actual: currentEffort });
    }

    if (driftedFields.length === 0) {
      if (VERBOSE)
        console.log(
          `ok: ${file} (tier=${tier} model=${expectedModel} effort=${expectedEffort || '(none)'})`
        );
      continue;
    }
    drift++;
    if (CHECK) {
      for (const f of driftedFields) {
        console.log(
          `DRIFT: ${file} tier=${tier} ${f.key} expected=${f.expected || '(absent)'} actual=${f.actual || '(missing)'}`
        );
      }
    } else {
      let newText = text;
      for (const f of driftedFields) {
        if (f.expected === undefined) {
          newText = removeField(newText, f.key);
        } else {
          // effort sits after model:, model sits after tier:
          newText = setField(newText, f.key, f.expected, f.key === 'effort' ? 'model' : 'tier');
        }
      }
      fs.writeFileSync(fpath, newText);
      const summary = driftedFields
        .map((f) => `${f.key} ${f.actual || '(none)'} → ${f.expected || '(removed)'}`)
        .join(', ');
      console.log(`synced: ${file} tier=${tier} ${summary}`);
      synced++;
    }
  }

  if (CHECK) {
    if (drift > 0) {
      console.error(
        `\n${drift} agent(s) out of sync. Run: plugins/glassdesk/bin/sync-models`
      );
      process.exit(1);
    }
    console.log(`OK — all agents synced (${inspected} checked, ${warned} skipped).`);
    return;
  }
  console.log(
    `\nDone. ${synced} synced, ${inspected - synced} unchanged, ${warned} skipped.`
  );
}

main();
