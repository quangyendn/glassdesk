{
  "name": "glassdesk",
  "version": "0.2.0",
  "description": "Claude Code marketplace featuring multi-agent orchestration, structured planning/coding workflows, and AI multimodal capabilities",
  "main": ".claude",
  "bin": {
    "glassdesk": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "templates/",
    "plugins/glassdesk/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "marketplace",
    "multi-agent",
    "parallel-execution",
    "workflow-automation",
    "ai-development"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "claude": ">=2.0.0"
  },
  "scripts": {
    "validate": "claude plugin validate .",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack:check": "npm pack --dry-run",
    "prepare": "husky",
    "guardrails:scan": "node scripts/guardrails/scan-personal-info.js",
    "guardrails:tarball": "node scripts/guardrails/scan-tarball.js",
    "guardrails:changelog": "node scripts/guardrails/verify-changelog.js",
    "guardrails:release-notes": "node scripts/guardrails/sanitize-release-notes.js",
    "prepublishOnly": "node scripts/guardrails/scan-tarball.js && node scripts/guardrails/verify-changelog.js && node scripts/guardrails/sanitize-release-notes.js"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6"
  }
}
