---
// Lazy-loaded Pagefind search modal.
import Icon from "./Icon.astro";
---

<button id="search-open" class="search-trigger" aria-label="Open search">
  <Icon name="search" size={14} />
  <span class="search-trigger__label">Search docs</span>
  <kbd class="search-trigger__kbd">⌘K</kbd>
</button>
<dialog id="search-dialog" aria-label="Search">
  <div id="pagefind-ui"></div>
  <button id="search-close" class="close" aria-label="Close search">
    Close
  </button>
</dialog>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<script>
  // pagefind-ui.js is a classic IIFE that attaches `PagefindUI` to window.
  // Load via <script src> (canonical pattern) — works across Astro/Vite versions.
  declare global {
    interface Window {
      PagefindUI?: new (opts: Record<string, unknown>) => unknown;
    }
  }

  const open = document.getElementById("search-open");
  const dlg = document.getElementById("search-dialog") as HTMLDialogElement | null;
  const close = document.getElementById("search-close");
  let initialised = false;
  let loaderPromise: Promise<void> | null = null;

  function loadPagefindUI(): Promise<void> {
    if (window.PagefindUI) return Promise.resolve();
    if (loaderPromise) return loaderPromise;
    loaderPromise = new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = "/pagefind/pagefind-ui.js";
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error("Failed to load pagefind-ui.js"));
      document.head.appendChild(s);
    });
    return loaderPromise;
  }

  open?.addEventListener("click", async () => {
    if (!dlg) return;
    if (!initialised) {
      try {
        await loadPagefindUI();
        if (!window.PagefindUI) throw new Error("window.PagefindUI missing after load");
        new window.PagefindUI({ element: "#pagefind-ui", showImages: false });
        initialised = true;
      } catch (err) {
        console.error("Pagefind UI failed to load:", err);
      }
    }
    dlg.showModal();
  });
  close?.addEventListener("click", () => dlg?.close());
</script>

<script>
  // ⌘K / Ctrl+K shortcut — open search dialog.
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      (document.querySelector(".search-trigger") as HTMLButtonElement | null)?.click();
    }
  });
</script>
